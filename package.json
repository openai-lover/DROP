{
  "name": "drop-community-rewards",
  "version": "0.1.0",
  "private": true,
  "description": "Playful rewards for communities. Real payouts, without the wallet hassle.",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:contracts": "forge test --root contracts",
    "firebase:emulators": "firebase emulators:start --only firestore --project demo-drop",
    "functions:build": "tsc -p functions/tsconfig.json",
    "worker": "tsx scripts/worker.ts",
    "verify:network": "tsx scripts/verify-network.ts"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@privy-io/react-auth": "3.48.1",
    "@privy-io/server-auth": "1.32.5",
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.57.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.7.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.37.0",
    "eslint-config-next": "16.4.0",
    "firebase-tools": "15.33.0",
    "sharp": "0.34.4",
    "solc": "0.8.30",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
