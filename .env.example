# Default is Monad Testnet. Never paste private values into a public repository.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
NEXT_PUBLIC_GAS_SPONSORSHIP_ENABLED=false
FIREBASE_PROJECT_ID=drop-5a400
# Default preserves ADC / optional private service-account JSON. Production may select vercel-oidc.
FIREBASE_CREDENTIAL_MODE=adc
FIREBASE_SERVICE_ACCOUNT_JSON=
# Keyless Vercel/GCP federation metadata; exact production IAM trust must exist first.
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
# Optional: the exact https://iam.googleapis.com/projects/.../providers/... audience.
# Blank uses Vercel's default team audience, which the GCP provider must allow.
GCP_OIDC_AUDIENCE=
# Local tests ONLY; use a demo- project and never a production database.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8089
DROP_CHAIN_ID=10143
DROP_RPC_URL=https://testnet-rpc.monad.xyz
DROP_ESCROW_ADDRESS=
DROP_AUTHORIZATION_PRIVATE_KEY=
DROP_RELAYER_PRIVATE_KEY=
PARTICIPANT_NULLIFIER_SECRET=
COUPON_ENCRYPTION_KEY=
DROP_CONFIRMATIONS=2
DROP_MAX_RELAYER_FEE_GWEI=500
DROP_MAX_RELAYER_TX_COST_MON=0.25
DROP_ENABLE_MAINNET=false
# Free Vercel mode: request = authenticated own-user after() + protected daily cron.
# Jobs are persistent; execution is request-assisted with a daily fallback, not every minute.
DROP_WORKER_MODE=disabled
# At least 32 characters. Configure privately on Vercel; never commit the value.
CRON_SECRET=
# Public HTTPS deployment origin, used for share metadata. Set after Vercel deployment.
NEXT_PUBLIC_APP_URL=
